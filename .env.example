# Solana Configuration
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Project Mnemonic - Replace with your actual project mnemonic (12 or 24 words)
# The private key will be derived from this mnemonic automatically
NEXT_PUBLIC_PROJECT_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# Global Registry Address - Replace with your actual global registry address
NEXT_PUBLIC_GLOBAL_REGISTRY_ADDRESS=11111111111111111111111111111112

# Optional: Custom RPC endpoints for better performance
# NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc.ankr.com/solana_devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/your-api-key
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# For mainnet, change network to:
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta